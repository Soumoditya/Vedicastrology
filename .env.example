# Supabase — safe to expose, protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The site's own origin. Used to build email confirmation and magic-link
# callbacks, so it must match the deployed domain exactly.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Service role key — bypasses row level security entirely.
# Only needed once payments are added. Never prefix it with NEXT_PUBLIC_,
# and never commit it.
# SUPABASE_SERVICE_ROLE_KEY=
